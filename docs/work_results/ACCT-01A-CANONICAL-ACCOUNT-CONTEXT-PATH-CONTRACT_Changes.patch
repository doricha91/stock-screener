     if create:
+        if allow_legacy_default or _is_legacy_root(root):
+            raise ValueError(
+                "Legacy paper_default compatibility is read-only and cannot be used with create=True."
+            )
         root.mkdir(parents=True, exist_ok=True)
 
     return root
